# Copy to .env and fill in real values for local runs:
#   cp .env.example .env

# LLM provider
OPENAI_API_KEY=your_openai_api_key_here

# Optional: LangSmith tracing
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quran-scholar

# Tafsir MCP — https://tafsirmcp.netlify.app/
TAFSIR_MCP_URL=https://mcp.tafsir.net/mcp
