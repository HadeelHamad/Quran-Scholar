# Copy to .env and fill in real values for local runs:
#   cp .env.example .env

# LLM provider (Planner and other agent nodes)
# OpenRouter: use sk-or-v1-... as OPENAI_API_KEY with OPENROUTER_BASE_URL
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: LangSmith tracing
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quran-scholar

# Tafsir MCP — https://tafsirmcp.netlify.app/
TAFSIR_MCP_URL=https://mcp.tafsir.net/mcp
